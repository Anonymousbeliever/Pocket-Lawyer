# Application
APP_NAME=Pocket Lawyer
APP_VERSION=0.1.0
ENVIRONMENT=development

# API
API_HOST=127.0.0.1
API_PORT=8000

# Database - to be configured later
DATABASE_URL=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=pocket_lawyer_legal

# Models
# The embedding model MUST be identical at ingest time and query time.
# If they drift apart, retrieval quality collapses with no error.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Retrieval
RETRIEVAL_TOP_K=15
RERANK_TOP_K=5
# Tail trimming: a source is kept if it scores at least this fraction
# of the best match for the same query. The top result always survives,
# so reranking never refuses on its own. There is deliberately no
# absolute floor - rerank scores are not comparable between queries.
RERANK_RELATIVE_RATIO=0.10

# Ingestion
EMBED_BATCH_SIZE=8
UPSERT_BATCH_SIZE=128
MAX_CHUNK_CHARS=4000
