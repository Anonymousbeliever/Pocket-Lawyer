# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Generated data
#
# Old stage-first layout, kept until the new pipeline is verified.
data/extracted/
data/manifests/
data/metadata/
data/processed/
data/cleaned/

# Immutable sources: large, binary, and licensing-sensitive.
data/raw/

# Document-first artifacts. Everything derived is regenerable and stays
# out of git; metadata.json is the exception - it is the provenance
# record (source, version, checksums, ingest date) and belongs in
# version control.
data/documents/*/extracted.txt
data/documents/*/cleaned.txt
data/documents/*/structure.json
data/documents/*/chunks.json

# Embeddings are regenerated by the ingestion pipeline and streamed
# straight into Qdrant. Never commit vectors - one document was 6.3 MB.
data/processed/*_embeddings.json

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
build/
dist/
*.egg-info/

# Transient evaluation run output; baseline.json is the tracked one
evaluation/last_run.json

# Cached retrieval and reranking results. Keyed on corpus, config and the
# source of the modules that decide a result, so it rebuilds itself.
evaluation/.cache/
